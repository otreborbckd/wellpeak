# Copia este archivo a .env y llénalo. NUNCA lo subas a Git (ya está en .gitignore).
# En Windows: copy .env.example .env

# ---------- MySQL local (8.0.16 o superior) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pulse
DB_USER=root
DB_PASSWORD=

# ---------- Servidor ----------
PORT=3000
# Dirección de la app: se usa en los enlaces de los correos (invitación, recuperación)
APP_URL=http://localhost:3000
# Pon true sólo si hay un proxy delante (nginx, Cloudflare, etc.)
TRUST_PROXY=false

# Secreto para firmar sesiones y enlaces de archivos (mínimo 32 caracteres, único por instalación).
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=e6c8d94dce006515894e3017bc7dfc8dbb8eb103081031aca950a9ab5ebfe7ddc29d5002b909c53f95381d860370f88c
JWT_DIAS=7

# ---------- Archivos (videos, PDFs, logos) ----------
STORAGE_DIR=./almacen

# ---------- Correo ----------
# Sin SMTP_HOST los enlaces de invitación y recuperación se imprimen en la consola del servidor (suficiente para pruebas locales).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PULSE · WellPeak <no-responder@tu-dominio.com>
# true = el colaborador debe confirmar su correo antes de entrar (requiere SMTP)
CONFIRMAR_CORREO=false


#contraseña de administrador para la primera cuenta (la que se crea con npm run init)
ADMIN_PASSWORD=BsY0Wdvq6zfZz9_o
# ngrok http 3000 --url https://tipper-yeast-upfront.ngrok-free.dev 