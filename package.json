{
  "name": "pulse-wellpeak",
  "private": true,
  "version": "1.0.1-mysql",
  "type": "module",
  "scripts": {
    "dev": "vite --config app/vite.config.ts",
    "dev:api": "node --env-file=.env --watch server/index.mjs",
    "build": "tsc -p app/tsconfig.json --noEmit && vite build --config app/vite.config.ts",
    "start": "node --env-file=.env server/index.mjs",
    "preview": "vite preview --config app/vite.config.ts",
    "db:migrar": "node --env-file=.env server/migrar.mjs",
    "admin": "node --env-file=.env server/crear-admin.mjs",
    "importar": "node --env-file=.env scripts/importar-programa.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "exceljs": "^4.4.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5"
  },
  "engines": { "node": ">=20.6" }
}
